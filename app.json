{
  "expo": {
    "name": "DealPro",
    "slug": "dealpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dealpro",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rixxelstudio.dealpro",
      "infoPlist": {
        "NSContactsUsageDescription": "DealPro a besoin d’accéder à ton répertoire pour relier un contact à une offre, une demande ou ton carnet.",
        "NSLocationWhenInUseUsageDescription": "DealPro enregistre la position d’un bien ou d’une visite.",
        "NSMicrophoneUsageDescription": "DealPro enregistre un mémo vocal pour en faire une opportunité.",
        "NSCameraUsageDescription": "DealPro photographie un panneau, un bien ou un document.",
        "NSPhotoLibraryUsageDescription": "DealPro joint une photo à une opportunité.",
        "UIBackgroundModes": ["remote-notification", "audio"],
        "LSApplicationQueriesSchemes": [
          "fb",
          "facebook",
          "whatsapp",
          "instagram",
          "twitter",
          "x",
          "tiktok",
          "snssdk1233",
          "snssdk1180",
          "musically"
        ]
      }
    },
    "android": {
      "package": "com.rixxelstudio.dealpro",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "DealPro",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": ["text/*"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DealPro a besoin d’accéder à tes photos pour les joindre à une opportunité.",
          "cameraPermission": "DealPro a besoin de la caméra pour photographier un bien ou un document."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#059669",
          "defaultChannel": "dealpro",
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/sounds/alarm.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/urgent.wav"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "DealPro a besoin d’accéder à ton répertoire pour relier un contact à une offre, une demande ou ton carnet."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DealPro enregistre la position d’un bien ou d’une visite."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-av",
      [
        "expo-build-properties",
        {
          "android": {
            "manifestQueries": {
              "package": [
                "com.facebook.katana",
                "com.instagram.android",
                "com.zhiliaoapp.musically",
                "com.ss.android.ugc.trill",
                "com.whatsapp",
                "com.twitter.android"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2d0cdc5a-7f01-4ed0-b2f5-67abdd073a9d"
      }
    },
    "owner": "rixxel-studio"
  }
}
